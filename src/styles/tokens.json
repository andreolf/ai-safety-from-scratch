{
  "$meta": {
    "name": "AI Safety from Scratch tokens",
    "brand": "Signal (locked by Francesco 2026-10-26; coral #FF6B81 approved for danger states only)",
    "version": "1.0.0",
    "created": "2026-10-26",
    "owner": "francesco-design-intern",
    "fonts_note": "Archivo ships via @fontsource-variable/archivo (import '@fontsource-variable/archivo/wdth.css' for the width axis). JetBrains Mono is not bundled in the site yet: add @fontsource-variable/jetbrains-mono or rely on the ui-monospace fallback."
  },
  "dark": {
    "--black": "#000000",
    "--white": "#FFFFFF",
    "--highlighter": "#EEFF41",
    "--ash": "#8F8F8F",
    "--ink": "#0E0E0E",
    "--alarm": "#FF6B81",
    "--bg": "#000000",
    "--surface": "#141414",
    "--surface-2": "#1F1F1F",
    "--line": "#2E2E2E",
    "--fg": "#FFFFFF",
    "--muted-strong": "#B8B8B8",
    "--muted": "#8F8F8F",
    "--accent": "#EEFF41",
    "--on-accent": "#0E0E0E",
    "--danger": "#FF6B81",
    "--on-danger": "#0E0E0E",
    "--focus-ring": "#EEFF41",
    "--font-display": "'Archivo Variable', 'Archivo', system-ui, sans-serif",
    "--font-body": "'Archivo Variable', 'Archivo', system-ui, sans-serif",
    "--font-mono": "'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace",
    "--stretch-expanded": "125%",
    "--stretch-normal": "100%",
    "--weight-black": "900",
    "--weight-extrabold": "800",
    "--weight-bold": "700",
    "--weight-regular": "400",
    "--text-sm": "1rem",
    "--text-body": "1.125rem",
    "--text-lg": "1.375rem",
    "--text-xl": "1.75rem",
    "--text-2xl": "2.25rem",
    "--text-3xl": "3rem",
    "--text-display": "4.5rem",
    "--leading-tight": "0.95",
    "--leading-snug": "1.2",
    "--leading-body": "1.55",
    "--tracking-display": "-0.015em",
    "--card-hook": "88px",
    "--card-title": "56px",
    "--card-body": "36px",
    "--card-min": "28px",
    "--space-1": "4px",
    "--space-2": "8px",
    "--space-3": "12px",
    "--space-4": "16px",
    "--space-5": "24px",
    "--space-6": "32px",
    "--space-7": "48px",
    "--space-8": "72px",
    "--radius-sm": "6px",
    "--radius": "14px",
    "--radius-lg": "24px",
    "--radius-pill": "999px",
    "--stroke-icon": "2px",
    "--stroke-box": "6px",
    "--stroke-mascot": "10px",
    "--glow-accent": "0 0 22px rgba(238, 255, 65, 0.35)",
    "--tap-min": "44px"
  },
  "daylight": {
    "--bg": "#FAFAF5",
    "--surface": "#FFFFFF",
    "--surface-2": "#F0F0EA",
    "--line": "#D9D9D2",
    "--fg": "#111111",
    "--muted-strong": "#4A4A4A",
    "--muted": "#6B6B6B",
    "--accent": "#EEFF41",
    "--on-accent": "#0E0E0E",
    "--danger": "#9E0025",
    "--on-danger": "#FFFFFF",
    "--focus-ring": "#111111"
  },
  "contrast": {
    "white on black": "21:1",
    "highlighter on black": "19.0:1",
    "ink on highlighter": "17.5:1",
    "muted-strong #B8B8B8 on black": "10.6:1 (AAA, small text OK)",
    "muted #8F8F8F on black": "6.5:1 (large or decorative only)",
    "alarm #FF6B81 on black": "7.7:1",
    "ink on alarm": "7.1:1",
    "#111111 on #FAFAF5": "18.0:1",
    "daylight danger #9E0025 on #FAFAF5": "8.1:1",
    "highlighter text on white": "1.1:1 (never)"
  }
}
